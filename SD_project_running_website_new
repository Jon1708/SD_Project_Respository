<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>F.R.O.G.S. Web App</title>

  <style>
    :root {
      --ucf-gold: #d4af37;
      --ucf-black: #050505;
      --panel: #121212;
      --muted: #aaaaaa;
      --good: #4fe08b;
      --warn: #ffd34d;
      --bad: #ff6a6a;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      background-color: var(--ucf-black);
      color: white;
      font-family: Arial, sans-serif;
      padding-bottom: 98px;
    }

    .app {
      padding: 25px;
      max-width: 1400px;
      margin: 0 auto;
    }

    h1 {
      text-align: center;
      color: var(--ucf-gold);
      letter-spacing: 2px;
      margin: 0 0 10px;
    }

    .subtitle {
      text-align: center;
      color: var(--muted);
      margin: 0 0 25px;
    }

    .status-card,
    .sensor-card,
    .switch-card,
    .info-card,
    .override-card {
      border: 2px solid var(--ucf-gold);
      border-radius: 18px;
      padding: 20px;
      background-color: var(--panel);
    }

    .status-card {
      margin-bottom: 25px;
    }

    .status-card h2,
    .sensor-card h3,
    .switch-card h3,
    .info-card h3,
    .override-card h3 {
      color: var(--ucf-gold);
      margin-top: 0;
    }

    .sensor-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
    }

    .sensor-card {
      text-align: center;
    }

    .icon {
      font-size: 32px;
      margin-bottom: 10px;
    }

    .value {
      font-size: 28px;
      font-weight: bold;
      margin: 10px 0;
    }

    .label {
      color: var(--muted);
      margin-bottom: 0;
    }

    .switch-row,
    .info-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
      margin-top: 25px;
    }

    .switch-card {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
    }

    .switch {
      position: relative;
      width: 60px;
      height: 34px;
      flex: 0 0 auto;
    }

    .switch input {
      display: none;
    }

    .slider {
      position: absolute;
      cursor: pointer;
      inset: 0;
      background-color: #444;
      border-radius: 34px;
      transition: 0.3s;
    }

    .slider:before {
      content: "";
      position: absolute;
      height: 26px;
      width: 26px;
      left: 4px;
      bottom: 4px;
      background-color: white;
      border-radius: 50%;
      transition: 0.3s;
    }

    input:checked + .slider {
      background-color: var(--ucf-gold);
    }

    input:checked + .slider:before {
      transform: translateX(26px);
    }

    .refresh-row {
      margin-top: 25px;
      text-align: center;
    }

    .refresh-btn {
      background-color: var(--ucf-gold);
      color: black;
      border: none;
      border-radius: 14px;
      padding: 14px 28px;
      font-size: 18px;
      font-weight: bold;
      cursor: pointer;
    }

    .refresh-btn:active {
      transform: scale(0.98);
    }

    .page { display: none; }
    .page.active { display: block; }

    .section-heading {
      color: var(--ucf-gold);
      margin: 0 0 8px;
    }

    .section-note {
      color: var(--muted);
      margin: 0 0 22px;
    }

    .state-good { color: var(--good); font-weight: bold; }
    .state-warn { color: var(--warn); font-weight: bold; }
    .state-bad { color: var(--bad); font-weight: bold; }

    .setting-row {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 12px;
      align-items: center;
      border-top: 1px solid #343434;
      padding: 14px 0;
    }

    .setting-row:first-of-type { border-top: 0; }

    .setting-row input {
      width: 100%;
      padding: 10px 12px;
      background: #050505;
      color: white;
      border: 1px solid var(--ucf-gold);
      border-radius: 10px;
      font-size: 16px;
    }

    .small-note {
      color: var(--muted);
      font-size: 14px;
      line-height: 1.45;
    }

    .bottom-tabs {
      position: fixed;
      z-index: 20;
      left: 0;
      right: 0;
      bottom: 0;
      background: #0d0d0d;
      border-top: 2px solid var(--ucf-gold);
      display: flex;
      justify-content: center;
      gap: 4px;
      padding: 10px max(10px, env(safe-area-inset-right)) calc(10px + env(safe-area-inset-bottom)) max(10px, env(safe-area-inset-left));
      overflow-x: auto;
    }

    .tab-btn {
      background: transparent;
      color: #d9d9d9;
      border: 1px solid transparent;
      border-radius: 12px;
      padding: 11px 15px;
      font-weight: bold;
      cursor: pointer;
      white-space: nowrap;
      min-width: 86px;
    }

    .tab-btn.active {
      background: var(--ucf-gold);
      color: black;
      border-color: var(--ucf-gold);
    }

    .override-actions {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      margin-top: 14px;
    }

    .override-btn {
      border: 1px solid var(--ucf-gold);
      background: #050505;
      color: white;
      border-radius: 12px;
      padding: 11px 15px;
      font-size: 15px;
      font-weight: bold;
      cursor: pointer;
    }

    .override-btn.active {
      background: var(--ucf-gold);
      color: black;
    }

    .override-btn.stop {
      border-color: #ff6a6a;
      color: #ff8d8d;
    }

    .override-btn.stop.active {
      background: #ff6a6a;
      color: black;
    }

    .admin-warning {
      border: 1px solid #ffbf47;
      background: #2b210c;
      border-radius: 12px;
      padding: 13px;
      margin-top: 18px;
      line-height: 1.45;
    }

    @media (max-width: 1050px) {
      .sensor-grid { grid-template-columns: repeat(2, 1fr); }
    }

    @media (max-width: 650px) {
      .app { padding: 18px; }
      .sensor-grid,
      .switch-row,
      .info-grid { grid-template-columns: 1fr; }
      .status-card,
      .sensor-card,
      .switch-card,
      .info-card,
      .override-card { padding: 17px; }
      h1 { font-size: 24px; }
      .tab-btn { min-width: 72px; padding: 10px 11px; font-size: 12px; }
    }
  </style>
</head>

<body>
  <div class="app">
    <h1>F.R.O.G.S. Water System</h1>
    <p class="subtitle">Filtration Resource for Off-Grid Systems · Monitor on Home · Configure in Admin</p>

    <section id="homePage" class="page active">
      <div class="status-card">
        <h2>System Status</h2>
        <p id="connectionStatus">❌ Device Disconnected</p>
        <p id="wifiStatus">⚠️ Waiting for ESP32 connection...</p>
        <p id="systemBlock">System state: <span class="state-warn">WAITING FOR DATA</span></p>
      </div>

      <div class="sensor-grid">
        <div class="sensor-card">
          <div class="icon">💧</div>
          <h3>TDS</h3>
          <p class="value" id="tdsValue">-- ppm</p>
          <p class="label">Water Purity</p>
        </div>

        <div class="sensor-card">
          <div class="icon">🌡️</div>
          <h3>Temperature</h3>
          <p class="value" id="tempValue">-- °F</p>
          <p class="label">Water Temperature</p>
        </div>

        <div class="sensor-card">
          <div class="icon">🌊</div>
          <h3>Flow 1</h3>
          <p class="value" id="flowValue">-- L/min</p>
          <p class="label">Input Water Flow</p>
        </div>

        <div class="sensor-card">
          <div class="icon">🚰</div>
          <h3>Flow 2</h3>
          <p class="value" id="homeFlow2Value">-- L/min</p>
          <p class="label">Output Water Flow</p>
        </div>

        <div class="sensor-card">
          <div class="icon">📊</div>
          <h3>F1 : F2</h3>
          <p class="value" id="homeRatioValue">-- : --</p>
          <p class="label">Direct Flow Values</p>
        </div>

        <div class="sensor-card">
          <div class="icon">🔋</div>
          <h3>Battery</h3>
          <p class="value" id="batteryValue">-- V</p>
          <p class="label">Battery Voltage</p>
        </div>

        <div class="sensor-card">
          <div class="icon">☀️</div>
          <h3>LDR State</h3>
          <p class="value" id="homeLdrState">--</p>
          <p class="label" id="homeLdrValue">Light Sensor</p>
        </div>

        <div class="sensor-card">
          <div class="icon">🪣</div>
          <h3>Tank Status</h3>
          <p class="value" id="tankStatusValue">--</p>
          <p class="label" id="tankStatusDetail">Float Switch: --</p>
        </div>
      </div>

      <div class="switch-row">
        <div class="switch-card">
          <div>
            <h3>Pump 1 Enable</h3>
            <p class="small-note">Requests low-pressure pump operation. Firmware safety rules remain active.</p>
          </div>
          <label class="switch">
            <input type="checkbox" id="pump1Switch" onchange="setPump1(this.checked)">
            <span class="slider"></span>
          </label>
        </div>

        <div class="switch-card">
          <div>
            <h3>Pump 2 Enable</h3>
            <p class="small-note">Requests high-pressure pump operation. Firmware safety rules remain active.</p>
          </div>
          <label class="switch">
            <input type="checkbox" id="pump2Switch" onchange="setPump2(this.checked)">
            <span class="slider"></span>
          </label>
        </div>
      </div>

      <div class="refresh-row">
        <button class="refresh-btn" onclick="getSensorData()">Refresh Data</button>
      </div>
    </section>

    <section id="adminPage" class="page">
      <h2 class="section-heading">Admin Settings</h2>
      <p class="section-note">Maintenance and protection settings. Readouts update from the ESP32 when the matching values are included in <code>/data</code>.</p>

      <div class="info-grid">
        <div class="info-card">
          <h3>Current Protection Status</h3>
          <div class="setting-row"><span>Battery Voltage Now</span><strong id="adminBatteryReadout">-- V</strong></div>
          <div class="setting-row"><span>Low-Voltage Disconnect (LVD)</span><strong id="lvdReadout">-- V</strong></div>
          <div class="setting-row"><span>Minimum Voltage Restart (MVR)</span><strong id="mvrReadout">-- V</strong></div>
          <div class="setting-row"><span>Daylight Threshold</span><strong id="lightThresholdReadout">--</strong></div>
          <div class="setting-row"><span>Minimum Flow</span><strong id="minFlowReadout">-- L/min</strong></div>
        </div>

        <div class="info-card">
          <h3>Voltage Protection Control</h3>
          <p class="small-note">LVD is the shutdown voltage. MVR is the voltage required before the system is allowed to restart.</p>

          <div class="setting-row">
            <label for="lvdSlider">Shutdown Voltage (LVD)</label>
            <div>
              <input id="lvdSlider" type="range" min="9.0" max="13.0" step="0.1" value="11.0" oninput="syncVoltageInputs('lvd')">
              <input id="lvdInput" type="number" min="9.0" max="13.0" step="0.1" value="11.0" oninput="syncVoltageInputs('lvd', true)">
            </div>
          </div>

          <div class="setting-row">
            <label for="mvrSlider">Restart Voltage (MVR)</label>
            <div>
              <input id="mvrSlider" type="range" min="9.2" max="13.5" step="0.1" value="12.0" oninput="syncVoltageInputs('mvr')">
              <input id="mvrInput" type="number" min="9.2" max="13.5" step="0.1" value="12.0" oninput="syncVoltageInputs('mvr', true)">
            </div>
          </div>

          <div class="refresh-row"><button class="refresh-btn" onclick="saveProtectionSettings()">Apply Voltage Settings</button></div>
          <p id="adminNotice" class="small-note" style="text-align:center;"></p>
        </div>

        <div class="info-card">
          <h3>Daylight Safety Control</h3>
          <p class="small-note">This maps to the existing OLED LDR CHK setting in firmware once the admin route is connected.</p>

          <div class="switch-card" style="margin-top:16px;">
            <div>
              <h3 style="margin-bottom:6px;">Daylight Threshold</h3>
              <p id="daylightControlStatus" class="small-note">Protection: ENABLED</p>
            </div>
            <label class="switch">
              <input type="checkbox" id="daylightEnableSwitch" checked onchange="setDaylightControl(this.checked)">
              <span class="slider"></span>
            </label>
          </div>

          <div class="setting-row" style="margin-top:16px;">
            <label for="daylightThresholdInput">LDR Threshold</label>
            <input id="daylightThresholdInput" type="number" min="0" max="4095" step="1" value="1200" oninput="previewDaylightThreshold()">
          </div>

          <div class="refresh-row">
            <button class="refresh-btn" onclick="saveDaylightThreshold()">Apply Daylight Settings</button>
          </div>
          <p id="daylightNotice" class="small-note" style="text-align:center;"></p>
        </div>
      </div>

      <div class="status-card" style="margin-top:25px;">
        <h2>Protection Rule</h2>
        <p id="voltageRuleText" class="state-warn">The system will shut down at -- V and may restart at -- V.</p>
        <p class="small-note">The webpage is ready for the admin save routes, but read/display works independently through <code>/data</code>.</p>
      </div>

      <div class="info-grid">
        <div class="override-card">
          <h3>Low-Pressure Pump Override</h3>
          <p id="lpOverrideState" class="state-warn">Override: OFF</p>
          <p class="small-note">Use only for supervised maintenance and troubleshooting.</p>
          <div class="override-actions">
            <button id="lpOverrideOnBtn" class="override-btn" onclick="setPumpOverride('lp', true)">Enable Override</button>
            <button id="lpOverrideOffBtn" class="override-btn stop active" onclick="setPumpOverride('lp', false)">Disable Override</button>
          </div>
        </div>
      </div>

      <div class="admin-warning">
        <strong>Important:</strong> only the low-pressure pump has a temporary maintenance override. The high-pressure pump remains protected from Admin override commands.
      </div>
      <p id="overrideNotice" class="small-note" style="text-align:center; margin-top:14px;"></p>

      <div class="status-card" style="margin-top:25px;">
        <h2 style="margin-bottom:8px;">Safety Condition Checks</h2>
        <p class="small-note">These match the OLED Admin Edit checks already in firmware, but are written out more clearly for the web app.</p>

        <div class="info-grid" style="margin-top:18px;">
          <div class="switch-card">
            <div>
              <h3>Light / Daylight Check</h3>
              <p id="ldrCheckStatus" class="small-note">Daylight safety check: ENABLED</p>
            </div>
            <label class="switch">
              <input type="checkbox" id="ldrCheckSwitch" checked onchange="setConditionCheck('ldr', this.checked)">
              <span class="slider"></span>
            </label>
          </div>

          <div class="switch-card">
            <div>
              <h3>Float Switch Check</h3>
              <p id="floatCheckStatus" class="small-note">Tank float check: ENABLED</p>
            </div>
            <label class="switch">
              <input type="checkbox" id="floatCheckSwitch" checked onchange="setConditionCheck('float', this.checked)">
              <span class="slider"></span>
            </label>
          </div>

          <div class="switch-card">
            <div>
              <h3>Voltage Protection Check</h3>
              <p id="lvdCheckStatus" class="small-note">Low-voltage check: ENABLED</p>
            </div>
            <label class="switch">
              <input type="checkbox" id="lvdCheckSwitch" checked onchange="setConditionCheck('lvd', this.checked)">
              <span class="slider"></span>
            </label>
          </div>
        </div>

        <div class="admin-warning" style="margin-top:18px;">
          <strong>Safety note:</strong> these switches map directly to <code>g_ldr_check</code>, <code>g_float_check</code>, and <code>g_lvd_check</code>. They are the same checks shown on the OLED Admin screen, just written out with clearer names.
        </div>

        <p id="conditionNotice" class="small-note" style="text-align:center; margin:18px 0 0;"></p>
      </div>

      <div class="status-card" style="margin-top:25px;">
        <h2>Reset Defaults</h2>
        <p class="small-note">Restores the Admin protection settings back to the firmware default values. This should match the OLED RESET DEFAULTS option.</p>
        <div class="refresh-row">
          <button class="refresh-btn" onclick="resetDefaults()">Reset Admin Defaults</button>
        </div>
        <p id="resetNotice" class="small-note" style="text-align:center; margin-top:14px;"></p>
      </div>
    </section>
  </div>

  <nav class="bottom-tabs" aria-label="FROGS app pages">
    <button class="tab-btn active" data-page="homePage">HOME</button>
    <button class="tab-btn" data-page="adminPage">ADMIN</button>
  </nav>

  <script>
    const demoData = {
      tds: 184,
      temperature: 74.3,
      flowRate: 1.25,
      flow1: 1.42,
      flow2: 1.18,
      battery: 12.6,
      pump1Enabled: false,
      pump2Enabled: false,
      daylight: "NIGHT",
      ldr: 0,
      tank: "LOW",
      blocked: "NIGHT",
      lvd: 11.0,
      mvr: 12.0,
      daylightThreshold: 1200,
      minFlow: 0.40,
      lpOverride: false,
      conditionChecks: {
        ldr: true,
        float: true,
        lvd: true
      },
      daylightSafetyEnabled: true,
      floatUp: false
    };

    let lastData = {};
    let demoMode = false;

    function setText(id, value) {
      const el = document.getElementById(id);
      if (el) el.innerText = value;
    }

    function setChecked(id, checked) {
      const el = document.getElementById(id);
      if (el) el.checked = Boolean(checked);
    }

    function setClass(id, className) {
      const el = document.getElementById(id);
      if (el) el.className = className;
    }

    function boolText(value) {
      return value ? "ON" : "OFF";
    }

    function firstDefined(data, names, fallback) {
      for (const name of names) {
        if (data[name] !== undefined && data[name] !== null) return data[name];
      }
      return fallback;
    }

    function toBool(value, fallback = false) {
      if (value === undefined || value === null) return fallback;
      if (typeof value === "boolean") return value;
      if (typeof value === "number") return value !== 0;
      if (typeof value === "string") {
        const v = value.trim().toLowerCase();
        if (["true", "1", "on", "enabled", "yes", "day", "full", "up"].includes(v)) return true;
        if (["false", "0", "off", "disabled", "no", "night", "low", "down"].includes(v)) return false;
      }
      return fallback;
    }

    function valueExists(value) {
      return value !== undefined && value !== null && value !== "--" && value !== "UNKNOWN";
    }

    function formatValue(value, digits = 1) {
      const n = Number(value);
      return Number.isFinite(n) ? n.toFixed(digits) : "--";
    }

    function normalizeDaylight(value) {
      if (!valueExists(value)) return "UNKNOWN";
      if (typeof value === "boolean") return value ? "DAY" : "NIGHT";
      if (typeof value === "number") return value !== 0 ? "DAY" : "NIGHT";
      const v = String(value).trim().toUpperCase();
      if (["DAY", "LIGHT", "BRIGHT", "SUN", "SUNLIGHT", "TRUE", "1", "ON"].includes(v)) return "DAY";
      if (["NIGHT", "DARK", "FALSE", "0", "OFF"].includes(v)) return "NIGHT";
      return v;
    }

    function buildConditionChecks(data) {
      const nested = firstDefined(data, ["conditionChecks", "checks"], null);
      if (nested && typeof nested === "object") {
        return {
          ldr: toBool(firstDefined(nested, ["ldr", "ldrCheck", "ldr_check"], true), true),
          float: toBool(firstDefined(nested, ["float", "floatCheck", "float_check"], true), true),
          lvd: toBool(firstDefined(nested, ["lvd", "lvdCheck", "lvd_check"], true), true)
        };
      }

      const oldNested = firstDefined(data, ["sensorStates", "sensor_states"], null);
      return {
        ldr: toBool(firstDefined(data, ["ldrCheck", "ldr_check", "daylightSafetyEnabled"], oldNested ? oldNested.ldr : true), true),
        float: toBool(firstDefined(data, ["floatCheck", "float_check"], oldNested ? oldNested.float : true), true),
        lvd: toBool(firstDefined(data, ["lvdCheck", "lvd_check"], oldNested ? oldNested.battery : true), true)
      };
    }

    function updatePage(data) {
      const tds = firstDefined(data, ["tds", "tdsPpm"], "--");
      const temperature = firstDefined(data, ["temperature", "temp", "tempF"], "--");
      const flow1 = firstDefined(data, ["flow1", "inputFlow", "flowRate", "flow"], "--");
      const flow2 = firstDefined(data, ["flow2", "outputFlow"], "--");
      const battery = firstDefined(data, ["battery", "batteryVoltage", "battery_voltage"], "--");

      const pump1 = toBool(firstDefined(data, ["pump1Enabled", "lpPumpEnabled", "lpEnabled", "lpPumpEnable", "lp_enable"], false));
      const pump2 = toBool(firstDefined(data, ["pump2Enabled", "hpPumpEnabled", "hpEnabled", "hpPumpEnable", "hp_enable"], false));

      setText("tdsValue", formatValue(tds, 1) + " ppm");
      setText("tempValue", formatValue(temperature, 1) + " °F");
      setText("flowValue", formatValue(flow1, 2) + " L/min");
      setText("homeFlow2Value", formatValue(flow2, 2) + " L/min");
      setText("batteryValue", formatValue(battery, 2) + " V");

      const n1 = Number(flow1);
      const n2 = Number(flow2);
      const flowPair = (Number.isFinite(n1) && Number.isFinite(n2))
        ? n1.toFixed(2) + " : " + n2.toFixed(2)
        : formatValue(flow1, 2) + " : " + formatValue(flow2, 2);
      setText("homeRatioValue", flowPair);

      setChecked("pump1Switch", pump1);
      setChecked("pump2Switch", pump2);

      const daylight = normalizeDaylight(firstDefined(data, ["daylight", "lightState", "daylightConfirmed", "lightConfirmed"], undefined));
      const ldr = firstDefined(data, ["ldr", "lightValue", "ldrRaw", "ldr_raw"], "--");
      setText("homeLdrState", daylight);
      setText("homeLdrValue", "LDR: " + (valueExists(ldr) ? ldr : "--"));

      const floatRaw = firstDefined(data, ["floatUp", "floatSwitchUp", "floatState", "tankFloat", "tankFull", "tank_full"], undefined);
      const tankRaw = firstDefined(data, ["tank", "tankStatus", "tank_status"], undefined);

      if (valueExists(floatRaw)) {
        const floatIsUp = toBool(floatRaw, false);
        setText("tankStatusValue", floatIsUp ? "FULL" : "LOW");
        setText("tankStatusDetail", "Float Switch: " + (floatIsUp ? "UP" : "DOWN"));
        setClass("tankStatusValue", "value " + (floatIsUp ? "state-good" : "state-warn"));
      } else if (valueExists(tankRaw)) {
        const tankText = String(tankRaw).toUpperCase();
        setText("tankStatusValue", tankText);
        setText("tankStatusDetail", "Float Switch: state not provided");
        setClass("tankStatusValue", "value " + (["OK", "FULL"].includes(tankText) ? "state-good" : "state-warn"));
      } else {
        setText("tankStatusValue", "UNKNOWN");
        setText("tankStatusDetail", "Float Switch: no data");
        setClass("tankStatusValue", "value state-warn");
      }

      const blocked = firstDefined(data, ["blocked", "blockReason", "block_reason"], "NONE");
      const blockedEl = document.getElementById("systemBlock");
      const clearState = blocked === "NONE" || blocked === "OK" || blocked === false;
      blockedEl.innerHTML = "System state: <span class='" + (clearState ? "state-good" : "state-warn") + "'>" + (clearState ? "SYSTEM OK" : "BLOCKED: " + blocked) + "</span>";

      const lvd = firstDefined(data, ["lvd", "lowVoltageDisconnect"], undefined);
      const mvr = firstDefined(data, ["mvr", "minimumVoltageRestart"], undefined);
      const daylightThreshold = firstDefined(data, ["daylightThreshold", "ldrThreshold", "ldr_threshold"], undefined);
      const minFlow = firstDefined(data, ["minFlow", "minimumFlow", "min_flow"], undefined);
      const daylightSafetyEnabled = toBool(firstDefined(data, ["daylightSafetyEnabled", "daylight_enabled", "daylightControlEnabled", "ldrCheck", "ldr_check"], true), true);
      const lpOverride = toBool(firstDefined(data, ["lpOverride", "lp_override", "lpPumpOverride"], false), false);

      setText("adminBatteryReadout", formatValue(battery, 2) + " V");
      setText("lvdReadout", valueExists(lvd) ? formatValue(lvd, 2) + " V" : "-- V");
      setText("mvrReadout", valueExists(mvr) ? formatValue(mvr, 2) + " V" : "-- V");
      setText("lightThresholdReadout", valueExists(daylightThreshold) ? daylightThreshold : "--");
      setText("minFlowReadout", valueExists(minFlow) ? formatValue(minFlow, 2) + " L/min" : "-- L/min");

      updateDaylightControlDisplay(daylightSafetyEnabled);
      updateOverrideDisplay("lp", lpOverride);
      updateConditionDisplays(buildConditionChecks(data));

      const displayLvd = valueExists(lvd) ? Number(lvd).toFixed(1) : "--";
      const displayMvr = valueExists(mvr) ? Number(mvr).toFixed(1) : "--";
      setText("voltageRuleText", "The system will shut down at " + displayLvd + " V and may restart at " + displayMvr + " V.");

      if (valueExists(lvd) &&
          document.activeElement !== document.getElementById("lvdInput") &&
          document.activeElement !== document.getElementById("lvdSlider")) {
        document.getElementById("lvdInput").value = Number(lvd).toFixed(1);
        document.getElementById("lvdSlider").value = Number(lvd).toFixed(1);
      }

      if (valueExists(mvr) &&
          document.activeElement !== document.getElementById("mvrInput") &&
          document.activeElement !== document.getElementById("mvrSlider")) {
        document.getElementById("mvrInput").value = Number(mvr).toFixed(1);
        document.getElementById("mvrSlider").value = Number(mvr).toFixed(1);
      }

      if (valueExists(daylightThreshold) &&
          document.activeElement !== document.getElementById("daylightThresholdInput")) {
        document.getElementById("daylightThresholdInput").value = daylightThreshold;
      }
    }

    async function getSensorData() {
      try {
        const response = await fetch("/data", { cache: "no-store" });
        if (!response.ok) throw new Error("ESP32 returned HTTP " + response.status);
        const data = await response.json();

        demoMode = false;
        lastData = { ...data };
        updatePage(lastData);

        setText("connectionStatus", "✅ Device Connected");
        setText("wifiStatus", "ESP32 data received successfully.");
      } catch (error) {
        demoMode = true;
        lastData = { ...demoData };
        updatePage(lastData);

        setText("connectionStatus", "🟡 Demo Mode");
        setText("wifiStatus", "Open this webpage through the ESP32 to use live /data values.");
      }
    }

    async function setPump1(enabled) {
      if (demoMode) {
        lastData.pump1Enabled = enabled;
        updatePage(lastData);
        return;
      }
      try {
        await fetch(enabled ? "/lp/enable" : "/lp/disable");
      } finally {
        getSensorData();
      }
    }

    async function setPump2(enabled) {
      if (demoMode) {
        lastData.pump2Enabled = enabled;
        updatePage(lastData);
        return;
      }
      try {
        await fetch(enabled ? "/hp/enable" : "/hp/disable");
      } finally {
        getSensorData();
      }
    }

    function updateDaylightControlDisplay(enabled) {
      setChecked("daylightEnableSwitch", enabled);
      const statusEl = document.getElementById("daylightControlStatus");
      if (statusEl) {
        statusEl.textContent = "Protection: " + (enabled ? "ENABLED" : "DISABLED");
        statusEl.className = enabled ? "state-good" : "state-warn";
      }
    }

    function previewDaylightThreshold() {
      const threshold = document.getElementById("daylightThresholdInput").value;
      setText("daylightNotice", "New daylight threshold ready to apply: " + threshold);
    }

    async function setDaylightControl(enabled) {
      const confirmationText = enabled
        ? "Enable daylight threshold protection?"
        : "Disable daylight threshold protection? Pumps may no longer be blocked based on the LDR state.";

      if (!window.confirm(confirmationText)) {
        setChecked("daylightEnableSwitch", !enabled);
        return;
      }

      if (demoMode) {
        lastData.daylightSafetyEnabled = enabled;
        updatePage(lastData);
        setText("daylightNotice", enabled ? "Demo mode: daylight protection enabled." : "Demo mode: daylight protection disabled.");
        return;
      }

      try {
        const response = await fetch("/admin/daylight", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ enabled })
        });
        if (!response.ok) throw new Error("ESP32 returned HTTP " + response.status);
        setText("daylightNotice", enabled ? "Daylight protection enabled." : "Daylight protection disabled.");
        getSensorData();
      } catch (error) {
        setChecked("daylightEnableSwitch", !enabled);
        setText("daylightNotice", "Firmware still needs the /admin/daylight route before this switch can control the real setting.");
      }
    }

    async function saveDaylightThreshold() {
      const threshold = Number(document.getElementById("daylightThresholdInput").value);
      if (!Number.isFinite(threshold) || threshold < 0 || threshold > 4095) {
        setText("daylightNotice", "Enter a valid LDR threshold from 0 to 4095.");
        return;
      }

      if (demoMode) {
        lastData.daylightThreshold = threshold;
        updatePage(lastData);
        setText("daylightNotice", "Demo mode: daylight threshold saved as " + threshold + ".");
        return;
      }

      try {
        const response = await fetch("/admin/daylight", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ threshold })
        });
        if (!response.ok) throw new Error("ESP32 returned HTTP " + response.status);
        setText("daylightNotice", "Daylight threshold updated to " + threshold + ".");
        getSensorData();
      } catch (error) {
        setText("daylightNotice", "Firmware still needs the /admin/daylight route before this value can be saved.");
      }
    }

    const conditionConfig = {
      ldr: {
        switchId: "ldrCheckSwitch",
        statusId: "ldrCheckStatus",
        name: "Light / Daylight Check",
        statusPrefix: "Daylight safety check"
      },
      float: {
        switchId: "floatCheckSwitch",
        statusId: "floatCheckStatus",
        name: "Float Switch Check",
        statusPrefix: "Tank float check"
      },
      lvd: {
        switchId: "lvdCheckSwitch",
        statusId: "lvdCheckStatus",
        name: "Voltage Protection Check",
        statusPrefix: "Low-voltage check"
      }
    };

    function updateConditionDisplays(checks) {
      Object.entries(conditionConfig).forEach(([key, config]) => {
        const enabled = toBool(checks[key], true);
        setChecked(config.switchId, enabled);
        const statusEl = document.getElementById(config.statusId);
        if (statusEl) {
          statusEl.textContent = config.statusPrefix + ": " + (enabled ? "ENABLED" : "DISABLED");
          statusEl.className = enabled ? "state-good" : "state-warn";
        }
      });
    }

    async function setConditionCheck(check, enabled) {
      const config = conditionConfig[check];
      if (!config) return;

      const confirmationText = enabled
        ? "Enable " + config.name + "?"
        : "Disable " + config.name + "? This should only be done for supervised maintenance or troubleshooting.";

      if (!window.confirm(confirmationText)) {
        setChecked(config.switchId, !enabled);
        return;
      }

      if (demoMode) {
        if (!lastData.conditionChecks) lastData.conditionChecks = buildConditionChecks(lastData);
        lastData.conditionChecks[check] = enabled;
        if (check === "ldr") lastData.daylightSafetyEnabled = enabled;
        updatePage(lastData);
        setText("conditionNotice", config.name + " is now " + (enabled ? "enabled." : "disabled.") + " (demo mode)");
        return;
      }

      try {
        const response = await fetch("/admin/check", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ check, enabled })
        });
        if (!response.ok) throw new Error("ESP32 returned HTTP " + response.status);
        setText("conditionNotice", config.name + " is now " + (enabled ? "enabled." : "disabled."));
        getSensorData();
      } catch (error) {
        setChecked(config.switchId, !enabled);
        setText("conditionNotice", "Firmware still needs the /admin/check route before this switch can control " + config.name + ".");
      }
    }

    function updateOverrideDisplay(pump, enabled) {
      const stateEl = document.getElementById(pump + "OverrideState");
      const onBtn = document.getElementById(pump + "OverrideOnBtn");
      const offBtn = document.getElementById(pump + "OverrideOffBtn");
      if (!stateEl || !onBtn || !offBtn) return;

      stateEl.textContent = "Override: " + (enabled ? "ON" : "OFF");
      stateEl.className = enabled ? "state-bad" : "state-warn";
      onBtn.classList.toggle("active", enabled);
      offBtn.classList.toggle("active", !enabled);
    }

    async function setPumpOverride(pump, enabled) {
      if (pump !== "lp") {
        setText("overrideNotice", "High-pressure pump override is disabled for protection.");
        return;
      }

      const confirmationText = enabled
        ? "Enable the low-pressure pump maintenance override? This should only be used while someone is actively supervising the system."
        : "Disable the low-pressure pump override and return to normal safety control?";

      if (!window.confirm(confirmationText)) return;

      if (demoMode) {
        lastData.lpOverride = enabled;
        updatePage(lastData);
        setText("overrideNotice", "Low-pressure pump override is " + (enabled ? "enabled in demo mode." : "disabled in demo mode."));
        return;
      }

      try {
        const response = await fetch("/admin/override", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ pump, enabled })
        });
        if (!response.ok) throw new Error("ESP32 returned HTTP " + response.status);
        setText("overrideNotice", "Low-pressure pump override is now " + (enabled ? "enabled." : "disabled."));
        getSensorData();
      } catch (error) {
        setText("overrideNotice", "Firmware still needs the /admin/override route before it can apply pump overrides.");
      }
    }

    function syncVoltageInputs(which, fromNumber = false) {
      const slider = document.getElementById(which + "Slider");
      const number = document.getElementById(which + "Input");
      if (fromNumber) slider.value = number.value;
      else number.value = slider.value;

      const lvd = Number(document.getElementById("lvdInput").value);
      const mvr = Number(document.getElementById("mvrInput").value);
      if (Number.isFinite(lvd) && Number.isFinite(mvr)) {
        setText("voltageRuleText", "The system will shut down at " + lvd.toFixed(1) + " V and may restart at " + mvr.toFixed(1) + " V.");
      }
    }

    async function saveProtectionSettings() {
      const lvd = Number(document.getElementById("lvdInput").value);
      const mvr = Number(document.getElementById("mvrInput").value);

      if (!Number.isFinite(lvd) || !Number.isFinite(mvr)) {
        setText("adminNotice", "Enter valid voltage values first.");
        return;
      }

      if (mvr <= lvd) {
        setText("adminNotice", "Restart voltage must be higher than the shutdown voltage.");
        return;
      }

      if (demoMode) {
        lastData.lvd = lvd;
        lastData.mvr = mvr;
        updatePage(lastData);
        setText("adminNotice", "Demo mode: voltage protection values saved in this browser.");
        return;
      }

      try {
        const response = await fetch("/admin/settings", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ lvd, mvr })
        });
        if (!response.ok) throw new Error("ESP32 returned HTTP " + response.status);
        setText("adminNotice", "Voltage protection settings applied to F.R.O.G.S.");
        getSensorData();
      } catch (error) {
        setText("adminNotice", "Firmware still needs the /admin/settings route before voltage settings can be saved.");
      }
    }


    async function resetDefaults() {
      const confirmed = window.confirm("Reset Admin settings to firmware defaults? This should restore LVD, MVR, condition checks, pump enable settings, and LP override to their default values.");
      if (!confirmed) return;

      if (demoMode) {
        lastData.lvd = demoData.lvd;
        lastData.mvr = demoData.mvr;
        lastData.conditionChecks = { ...demoData.conditionChecks };
        lastData.daylightSafetyEnabled = demoData.daylightSafetyEnabled;
        lastData.lpOverride = false;
        lastData.pump1Enabled = true;
        lastData.pump2Enabled = true;
        updatePage(lastData);
        setText("resetNotice", "Demo mode: Admin defaults restored.");
        return;
      }

      try {
        const response = await fetch("/admin/reset", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ reset: true })
        });

        if (!response.ok) throw new Error("ESP32 returned HTTP " + response.status);
        setText("resetNotice", "Admin defaults restored.");
        getSensorData();
      } catch (error) {
        setText("resetNotice", "Firmware still needs the /admin/reset route before the webpage can reset the real default values.");
      }
    }

    document.querySelectorAll(".tab-btn").forEach(button => {
      button.addEventListener("click", () => {
        document.querySelectorAll(".page").forEach(page => page.classList.remove("active"));
        document.querySelectorAll(".tab-btn").forEach(tab => tab.classList.remove("active"));
        document.getElementById(button.dataset.page).classList.add("active");
        button.classList.add("active");
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
    });

    setInterval(getSensorData, 3000);
    getSensorData();
  </script>
</body>
</html>
